rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lets the app count replies across all posts for the unread badges.
    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }

    // Anyone with the link can read and add posts. Nobody can edit or delete
    // (delete from the Firebase console if needed). No author is ever stored.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['about', 'kind', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['about', 'kind', 'text', 'createdAt'])
        && request.resource.data.about is string
        && request.resource.data.about.size() > 0
        && request.resource.data.about.size() <= 40
        && request.resource.data.kind in ['question', 'idea']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.keys().hasAll(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
